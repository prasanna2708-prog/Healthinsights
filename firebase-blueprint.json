{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated platform user profile with RBAC role assignment (PII excluded).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "enum": ["admin", "analyst", "viewer"]
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "role", "department", "createdAt", "updatedAt"]
    },
    "UserPrivateContact": {
      "title": "UserPrivateContact",
      "description": "Isolated PII subcollection storing user email address.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "ClaimsDataset": {
      "title": "ClaimsDataset",
      "description": "Metadata and summary statistics for an uploaded and preprocessed health insurance claims dataset.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "sourceFileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "visibility": {
          "type": "string",
          "enum": ["private", "shared"]
        },
        "totalClaims": {
          "type": "integer"
        },
        "cleanedClaims": {
          "type": "integer"
        },
        "anomaliesDetected": {
          "type": "integer"
        },
        "totalClaimAmount": {
          "type": "number"
        },
        "avgClaimAmount": {
          "type": "number"
        },
        "lowRiskCount": {
          "type": "integer"
        },
        "mediumRiskCount": {
          "type": "integer"
        },
        "highRiskCount": {
          "type": "integer"
        },
        "encryptionAlg": {
          "type": "string",
          "enum": ["AES-256-GCM"]
        },
        "keyFingerprint": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "sourceFileName",
        "ownerId",
        "ownerName",
        "visibility",
        "totalClaims",
        "cleanedClaims",
        "anomaliesDetected",
        "totalClaimAmount",
        "avgClaimAmount",
        "lowRiskCount",
        "mediumRiskCount",
        "highRiskCount",
        "encryptionAlg",
        "keyFingerprint",
        "createdAt",
        "updatedAt"
      ]
    },
    "ProcessedClaim": {
      "title": "ProcessedClaim",
      "description": "Individual normalized, pseudonymized, and risk-tagged claim record inside a dataset.",
      "type": "object",
      "properties": {
        "claimId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "datasetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "visibility": {
          "type": "string",
          "enum": ["private", "shared"]
        },
        "encryptedPatientId": {
          "type": "string",
          "minLength": 12,
          "maxLength": 256
        },
        "maskedPatientId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32
        },
        "serviceDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "amount": {
          "type": "number"
        },
        "claimType": {
          "type": "string",
          "enum": ["Inpatient", "Outpatient", "Pharmacy", "Diagnostics"]
        },
        "icd10Code": {
          "type": "string",
          "minLength": 2,
          "maxLength": 16
        },
        "icd10Category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "patientAge": {
          "type": "integer"
        },
        "ageGroup": {
          "type": "string",
          "enum": ["0-17", "18-34", "35-49", "50-64", "65+"]
        },
        "region": {
          "type": "string",
          "enum": ["Northeast", "Midwest", "South", "West"]
        },
        "policyType": {
          "type": "string",
          "enum": ["PPO", "HMO", "EPO", "HDHP", "Medicare Advantage"]
        },
        "comorbidities": {
          "type": "integer"
        },
        "isAnomaly": {
          "type": "boolean"
        },
        "anomalyReason": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "riskScore": {
          "type": "number"
        },
        "riskSegment": {
          "type": "string",
          "enum": ["Low Risk", "Medium Risk", "High Risk"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "claimId",
        "datasetId",
        "ownerId",
        "visibility",
        "encryptedPatientId",
        "maskedPatientId",
        "serviceDate",
        "amount",
        "claimType",
        "icd10Code",
        "icd10Category",
        "patientAge",
        "ageGroup",
        "region",
        "policyType",
        "comorbidities",
        "isAnomaly",
        "anomalyReason",
        "riskScore",
        "riskSegment",
        "createdAt"
      ]
    },
    "RiskRulePreset": {
      "title": "RiskRulePreset",
      "description": "Customizable actuarial risk-segment tagging threshold and weighting configuration.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "visibility": {
          "type": "string",
          "enum": ["private", "shared"]
        },
        "highAmountThreshold": {
          "type": "number"
        },
        "mediumAmountThreshold": {
          "type": "number"
        },
        "highComorbidityThreshold": {
          "type": "integer"
        },
        "mediumComorbidityThreshold": {
          "type": "integer"
        },
        "inpatientWeight": {
          "type": "number"
        },
        "ageThreshold": {
          "type": "integer"
        },
        "ageWeight": {
          "type": "number"
        },
        "anomalyZScoreThreshold": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "ownerId",
        "visibility",
        "highAmountThreshold",
        "mediumAmountThreshold",
        "highComorbidityThreshold",
        "mediumComorbidityThreshold",
        "inpatientWeight",
        "ageThreshold",
        "ageWeight",
        "anomalyZScoreThreshold",
        "createdAt",
        "updatedAt"
      ]
    },
    "PremiumScenario": {
      "title": "PremiumScenario",
      "description": "Saved what-if actuarial scenario and Monte Carlo premium impact analysis.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "datasetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "visibility": {
          "type": "string",
          "enum": ["private", "shared"]
        },
        "frequencyDeltaPct": {
          "type": "number"
        },
        "severityDeltaPct": {
          "type": "number"
        },
        "highRiskReductionPct": {
          "type": "number"
        },
        "adminLoadPct": {
          "type": "number"
        },
        "targetLossRatioPct": {
          "type": "number"
        },
        "baselinePurePremium": {
          "type": "number"
        },
        "projectedPurePremium": {
          "type": "number"
        },
        "projectedGrossPremium": {
          "type": "number"
        },
        "p95AggregateLoss": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "datasetId",
        "ownerId",
        "visibility",
        "frequencyDeltaPct",
        "severityDeltaPct",
        "highRiskReductionPct",
        "adminLoadPct",
        "targetLossRatioPct",
        "baselinePurePremium",
        "projectedPurePremium",
        "projectedGrossPremium",
        "p95AggregateLoss",
        "createdAt"
      ]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable HIPAA/GDPR compliance audit event for data access, encryption, and RBAC changes.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorRole": {
          "type": "string",
          "enum": ["admin", "analyst", "viewer"]
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "resourcePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "details": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "actorUid",
        "actorRole",
        "action",
        "resourcePath",
        "details",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User RBAC profile (uid, displayName, role, department)."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateContact" },
      "description": "Isolated PII subcollection for user email."
    },
    "/datasets/{datasetId}": {
      "schema": { "$ref": "#/entities/ClaimsDataset" },
      "description": "Uploaded and preprocessed health insurance claims dataset metadata."
    },
    "/datasets/{datasetId}/claims/{claimId}": {
      "schema": { "$ref": "#/entities/ProcessedClaim" },
      "description": "Normalized and risk-tagged claim records with AES-256-GCM encrypted patient IDs."
    },
    "/riskRules/{ruleId}": {
      "schema": { "$ref": "#/entities/RiskRulePreset" },
      "description": "Customizable risk-segment tagging thresholds and weights."
    },
    "/scenarios/{scenarioId}": {
      "schema": { "$ref": "#/entities/PremiumScenario" },
      "description": "Saved premium cost-uncertainty and what-if simulation scenarios."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable HIPAA/GDPR compliance audit trail."
    }
  }
}
